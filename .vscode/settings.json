{
  "files.readonlyInclude": {
    "**/routeTree.gen.ts": true,
    "**/.tanstack/**/*": true,
    "pnpm-lock.yaml": true,
    "bun.lock": true
  },
  "files.watcherExclude": {
    "**/routeTree.gen.ts": true,
    "**/.tanstack/**/*": true,
    "pnpm-lock.yaml": true,
    "bun.lock": true
  },
  "search.exclude": {
    "**/routeTree.gen.ts": true,
    "**/.tanstack/**/*": true,
    "pnpm-lock.yaml": true,
    "bun.lock": true
  },

  // use LF line endings
  "files.eol": "\n",

   // associate .env files with dotenv (vscode extension)
  "files.associations": {
    ".env": "dotenv",
    ".env.*.local": "dotenv",
    ".env.local": "dotenv"
  },

  // set prettier as default formatter for json, ts, tsx, js, jsx, css
  "[json][jsonc][typescript][typescriptreact][javascript][javascriptreact][css]": {
    "editor.defaultFormatter": "biomejs.biome"
  },

  // indentation and formatting settings
  "editor.autoIndent": "advanced",
  "editor.codeActionsOnSave": {
    "source.fixAll.biome": "explicit",
    "source.organizeImports.biome": "explicit"
  },
  "editor.detectIndentation": false,
  "editor.formatOnSave": true,
  "editor.indentSize": "tabSize",
  "editor.insertSpaces": true,
  "editor.tabSize": 2,
  "biome.enableProjectConfig": true,
  "html.format.wrapLineLength": 120,
  "json.schemaDownload.enable": true,
}
