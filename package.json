{
  "name": "tanstack-turbo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "dev:web": "turbo run dev --filter=@repo/web",
    "start": "turbo run start",
    "start:web": "turbo run start --filter=@repo/web",
    "test": "turbo run test",
    "view-report": "turbo run view-report",
    "lint": "biome lint",
    "format": "biome format --write",
    "check-types": "turbo run check-types",
    "check": "bun biome check --write && turbo run check-types",
    "prepare": "simple-git-hooks",
    "deps": "bunx taze@latest -Ilwr",
    "deps:major": "bunx taze@latest major -Ilwr",
    "db": "bun --filter=@repo/db run db",
    "ui": "bun --filter=@repo/ui run ui",
    "ui:web": "bun --filter=@repo/web run ui",
    "auth:secret": "bunx @better-auth/cli@latest secret",
    "auth:generate": "bunx @better-auth/cli@latest generate --config ./packages/auth/src/auth.ts --y --output ./packages/db/src/schema/auth.prisma"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "tooling/*"
  ],
  "catalog": {
    "@base-ui/react": "^1.2.0",
    "@hono/zod-validator": "^0.7.6",
    "@prisma/adapter-pg": "^7.4.1",
    "@prisma/client": "^7.4.1",
    "@t3-oss/env-core": "^0.13.10",
    "@tanstack/react-devtools": "^0.9.6",
    "@tanstack/react-form-devtools": "^0.2.16",
    "@tanstack/react-form-start": "^1.28.3",
    "@tanstack/react-query-devtools": "^5.91.3",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-router-devtools": "^1.161.3",
    "@tanstack/react-router-ssr-query": "^1.161.3",
    "@tanstack/react-router": "^1.161.3",
    "@tanstack/react-start": "^1.161.3",
    "@types/bun": "latest",
    "@types/pg": "^8.16.0",
    "@types/react-dom": "^19.2.3",
    "@types/react": "^19.2.14",
    "better-auth": "^1.4.18",
    "canvas": "^3.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "hono": "^4.12.1",
    "lucide-react": "^0.575.0",
    "pg": "^8.18.0",
    "postgres": "^3.4.8",
    "prisma-zod-generator": "^2.1.4",
    "prisma": "^7.4.1",
    "react-dom": "^19.2.4",
    "react": "^19.2.4",
    "shadcn": "^3.8.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "zod": "^4.3.6"
  },
  "catalogs": {
    "build": {
      "@biomejs/biome": "2.3.15",
      "@commitlint/cli": "^20.3.1",
      "@commitlint/config-conventional": "^20.3.1",
      "@hono/node-server": "^1.19.9",
      "@hono/vite-build": "^1.9.3",
      "@hono/vite-dev-server": "^0.25.0",
      "@tailwindcss/vite": "^4.2.0",
      "@tanstack/devtools-vite": "^0.5.1",
      "@vitejs/plugin-react": "^5.1.4",
      "babel-plugin-react-compiler": "^1.0.0",
      "dotenv-cli": "^11.0.0",
      "glob": "^13.0.6",
      "lint-staged": "^16.2.7",
      "nitro": "npm:nitro-nightly@latest",
      "simple-git-hooks": "^2.13.1",
      "tsx": "^4.21.0",
      "turbo": "^2.8.9",
      "vite": "^8.0.0-beta.15"
    },
    "testing": {
      "@testing-library/dom": "^10.4.1",
      "@testing-library/jest-dom": "^6.9.1",
      "@testing-library/react": "^16.3.2",
      "@testing-library/user-event": "^14.6.1",
      "@vitest/coverage-istanbul": "^4.0.18",
      "@vitest/ui": "^4.0.18",
      "jsdom-testing-mocks": "^1.16.0",
      "jsdom": "^27.4.0",
      "nyc": "^17.1.0",
      "open-cli": "^8.0.0",
      "vitest-axe": "^0.1.0",
      "vitest": "^4.0.18"
    }
  },
  "overrides": {
    "vite": "^8.0.0-beta.15"
  },
  "trustedDependencies": [
    "simple-git-hooks"
  ],
  "devDependencies": {
    "@biomejs/biome": "catalog:build",
    "@commitlint/cli": "catalog:build",
    "@commitlint/config-conventional": "catalog:build",
    "@repo/biome-config": "workspace:*",
    "@repo/vitest-config": "workspace:*",
    "dotenv-cli": "catalog:build",
    "lint-staged": "catalog:build",
    "simple-git-hooks": "catalog:build",
    "turbo": "catalog:build",
    "vitest": "catalog:testing"
  },
  "packageManager": "bun@1.3.9",
  "engines": {
    "node": ">=22"
  },
  "simple-git-hooks": {
    "pre-push": "bun run format",
    "pre-commit": "bun lint-staged",
    "commit-msg": "bun commitlint --edit ${1}"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "lint-staged": {
    "*": "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
  },
  "cspell": {
    "version": "0.2",
    "useGitignore": true,
    "language": "en-GB",
    "ignorePaths": [
      "**/routeTree.gen.ts"
    ],
    "words": [
      "biome",
      "turborepo",
      "oklch",
      "shadcn",
      "tanstack",
      "tanstackstart",
      "vinxi",
      "vite"
    ]
  }
}
