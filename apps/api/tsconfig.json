{
  "extends": "@repo/tsconfig/base.json",
  "compilerOptions": {
    "composite": true,
    "moduleResolution": "bundler",
    "types": ["bun", "vite/client"],
    "lib": ["ESNext"],
    "noEmit": false,
    "paths": {
      "~/*": ["./src/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "src/client.ts"]
}
